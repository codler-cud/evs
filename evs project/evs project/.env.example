# =============================================================================
# EcoSort Environment Configuration Example
# Copy this file to .env (or backend/.env) and replace secret values before
# deploying to production. Never commit real secrets to version control.
# =============================================================================

# --- Backend Application ---
APP_NAME=EcoSort API
ENVIRONMENT=development
DEBUG=true

# --- Security & JWT ---
# Generate a strong random key for production (e.g., `openssl rand -hex 32`)
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# SQLite (default for local development and college demonstration)
DATABASE_URL=sqlite:///./ecosort.db
# PostgreSQL (ready for production migration — uncomment & configure below)
# DATABASE_URL=postgresql+psycopg2://ecosort_user:ecosort_password@localhost:5432/ecosort

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- AI Waste Classification ---
# Supported values: cv_prototype (built-in Pillow/NumPy CV prototype)
AI_PROVIDER=cv_prototype
AI_CONFIDENCE_THRESHOLD=0.62
MAX_UPLOAD_SIZE_MB=5

# --- Demo Seed Data ---
# Set to true for college demo / first-run seeding; set false in production
SEED_DEMO_DATA=true

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api
